# Backend Environment Variables

# NVIDIA API Key - Required for using NVIDIA AI models
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Backend is accessible at: http://localhost:4000

# Flask Server Configuration
# Host address for the Flask server
FLASK_HOST=0.0.0.0

# Port for the Flask server
FLASK_PORT=4000

# Enable CORS (Cross-Origin Resource Sharing)
# Set to True to allow requests from different origins
FLASK_CORS_ENABLED=True

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: Model paths (if using custom model locations)
# MODEL_PATH=./chatbot_model_final.keras
# TOKENIZER_PATH=./tokenizer.pkl
# RESPONSE_MAP_PATH=./response_map.json
# DATA_PATH=./data.json

# Optional: spaCy language model
# SPACY_MODEL=es_core_news_sm

# Optional: Maximum context length for conversations
# MAX_CONVERSATION_MEMORY=10

# Optional: Request timeout in seconds
# REQUEST_TIMEOUT=60
