# Frontend Environment Variables

# Flask Backend URL - Configure the URL where your Flask API server is running
# Example: http://localhost:4000 (for local development)
# Example: https://your-production-domain.com (for production)
FLASK_URL=http://localhost:4000

# Flask Chat Endpoint Path
FLASK_CHAT_PATH=/chat

# Request timeout in milliseconds for Flask API calls
# Default: 10000ms (10 seconds)
FLASK_TIMEOUT_MS=10000

# TTS (Text-to-Speech) API configuration
TTS_ENDPOINT=http://localhost:5002/api/tts
TTS_PROVIDER=coqui
# TTS_API_KEY=your_tts_api_key

# NVIDIA API Key - Required for using NVIDIA AI models for translation
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
